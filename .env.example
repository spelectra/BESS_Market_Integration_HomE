# Copy this file to .env and fill in your own credentials. Never commit .env.

# ENTSO-E Transparency Platform API key
# Get one at https://transparency.entsoe.eu → My Account Settings → Web API Security Token
ENTSOE_API_KEY=your-key-here

# Netztransparenz (German TSOs) OAuth2 client credentials
# Register at https://extranet.netztransparenz.de → "API-Clients" → create a client.
# The client ID and secret are shown once on creation; copy both here.
NTP_CLIENT_ID=your-client-id-here
NTP_CLIENT_SECRET=your-client-secret-here
